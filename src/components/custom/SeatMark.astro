---
/**
 * @fileoverview The armchair mark
 *
 * The same lucide `armchair` the favicon and the seat map use, kept in one place so the
 * error pages and the icon cannot drift apart. Server-rendered: it is four static paths
 * and needs no island
 */

interface Props {
  /**
   * Size and tone. The error pages draw it large, the home page small
   *
   * @default "mx-auto size-20 text-primary"
   */
  class?: string;
}

const { class: className = "mx-auto size-20 text-primary" } = Astro.props;
---

{
  /* Decorative. The heading beside it says everything this says, so naming it would only
    make a screen reader read the page twice */
}
<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}>
  <path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"></path>
  <path
    d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"
  ></path>
  <path d="M5 18v2"></path>
  <path d="M19 18v2"></path>
</svg>
